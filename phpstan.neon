includes:
    - config/extension.neon

parameters:
    level: 8

    type_perfect:
        no_param_type_removal: true
        no_isset_on_object: true
        no_empty_on_object: true

    paths:
        - src
        - tests
        - packages/type-perfect/src
        - packages/type-perfect/tests

    type_coverage:
        # lowered since the source is downgraded to PHP 7.4, where union
        # return/param types and typed constants cannot be native declarations
        return_type: 96
        param_type: 99
        property_type: 100
        constant_type: 0

    ignoreErrors:
        - identifier: missingType.generics

        # inherited from rector/type-perfect, resolving these means rewriting the rule internals
        -
            identifier: phpstanApi.instanceofType
            paths:
                - packages/type-perfect/src
        -
            identifier: phpstanApi.instanceofAssumption
            paths:
                - packages/type-perfect/src

        # needed to access metadata about paths
        -
            message: '#PHPStan\\Analyser\\LazyInternalScopeFactory#'
            identifier: phpstanApi.class

        -
            message: '#PHPStan\\DependencyInjection\\Nette\\NetteContainer#'
            identifier: phpstanApi.method

        -
            message: '#PHPStan\\DependencyInjection\\MemoizingContainer#'
            identifier: phpstanApi.class

    excludePaths:
        - "*/Fixture/*"
        - "*/Source/*"
